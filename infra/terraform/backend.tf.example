# Example configuration for the application Terraform backend.
# The dedicated S3 state bucket has already been deployed.
# Copy this file to backend.tf and replace the bucket placeholder.
# Never commit backend.tf or Terraform state files.

terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_PRIVATE_STATE_BUCKET"
    key          = "hotel-ai-copilot/dev/terraform.tfstate"
    region       = "ap-southeast-2"
    encrypt      = true
    use_lockfile = true
  }
}